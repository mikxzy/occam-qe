&CONTROL
   calculation = 'vc-relax'
   prefix      = 'linbo3'
   outdir      = './tmp/'
   pseudo_dir  = '/work/pseudo'
   verbosity   = 'high'
   tstress     = .true.
   tprnfor     = .true.
   etot_conv_thr = 1.0d-8
   forc_conv_thr = 5.0d-5
/
&SYSTEM
   ibrav       = 0
   nat         = 10
   ntyp        = 3
   ecutwfc     = 120.0
   ecutrho     = 480.0
   occupations = 'fixed'
/
&ELECTRONS
   conv_thr    = 1.0d-10
   mixing_beta = 0.7d0
   electron_maxstep = 200
/
&IONS
   ion_dynamics = 'bfgs'
/
&CELL
   cell_dynamics = 'bfgs'
   press_conv_thr = 0.1
/
